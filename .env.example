# ==============================================================
# BalanceVault Environment Configuration
# ==============================================================

# Application Environment: 'development' or 'production'
LEDGERLINE_ENV=development

# Database Connection URL (PostgreSQL in production; SQLite used if empty)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://balancevault_app:secret_password@localhost:5432/balancevault

# Redis Connection URL for Rate Limiting
# Format: redis://[:password@]host:port[/db_number]
REDIS_URL=redis://localhost:6379/0

# Rate Limiting Configuration
# Fail-safe mode: if true, allows traffic if Redis is unreachable; if false, fails closed
RATE_LIMIT_FAIL_SAFE=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_TRANSACTION_PER_MINUTE=60

# JWT / Token Signing Secret (Must be set to a high-entropy string in production)
LEDGERLINE_TOKEN_SECRET=replace_with_a_64_character_random_hex_string

# Allowed CORS Origins (comma-separated for multi-origin)
CORS_ORIGINS=http://localhost:8000,http://localhost:3000,https://balancevault.vercel.app

# Port for local and container runtime
PORT=8000

